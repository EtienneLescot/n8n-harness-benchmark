    {
      "id": "2911e8ca-dec7-4252-a0ff-11e5a1bc3616",
      "name": "Executive Synthesis Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
