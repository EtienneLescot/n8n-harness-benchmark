      ],
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\"greeting\":\"Bonjour, voici votre briefing exécutif du jour.\",\"dailyTheme\":\"Focus Stratégique & Clôture Budgétaire\",\"topPriorities\":[\"Valider le budget avec Sophie lors du point de 14h\",\"Traiter les demandes urgentes avant midi\"],\"crossCorrelations\":[\"L email de Sophie concerne directement le sujet de votre réunion de 14h\"],\"strategicAdvice\":\"Privilégiez 2h de deep work ce matin pour finaliser vos dossiers.\",\"motivationalQuote\":\"L efficacité consiste à faire les bonnes choses au bon moment.\"}"
      }
    },
    {
      "id": "37420673-3657-4953-8991-af19310e3b20",
      "name": "Generate HTML Dashboard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1824,
        304
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const synthesis = $('Executive Synthesis Agent').all()[0]?.json || {};\nconst emailData = $('Email Triage Agent').all()[0]?.json || {};\nconst calendarData = $('Calendar Agenda Agent').all()[0]?.json || {};\n\nconst todayStr = new Date().toLocaleDateString('fr-FR', {\n  weekday: 'long',\n  year: 'numeric',\n  month: 'long',\n  day: 'numeric'\n});\n\nconst emails = emailData.emails || [];\nconst events = calendarData.events || [];\nconst priorities = synthesis.topPriorities || [];\nconst correlations = synthesis.crossCorrelations || [];\n\nconst emailRowsHtml = emails.length > 0\n  ? emails.map(e => {\n      const badgeClass = e.category === 'urgent'\n        ? 'bg-rose-100 text-rose-700 border-rose-200'\n        : (e.category === 'action_required'\n          ? 'bg-amber-100 text-amber-700 border-amber-200'\n          : 'bg-emerald-100 text-emerald-700 border-emerald-200');\n      const actionHtml = e.actionRequired\n        ? '<div class=\"mt-2 text-xs font-medium text-amber-800 bg-amber-50 p-2 rounded border border-amber-200\">⚡ Action : ' + e.actionRequired + '</div>'\n        : '';\n      return '<div class=\"p-4 bg-white rounded-xl border border-slate-100 shadow-sm hover:shadow-md transition\">'\n        + '<div class=\"flex items-center justify-between gap-2 mb-1\">'\n        + '<span class=\"font-semibold text-slate-900 text-sm\">' + (e.from || 'Inconnu') + '</span>'\n        + '<span class=\"text-xs px-2 py-0.5 rounded-full font-semibold border ' + badgeClass + '\">' + (e.category || 'Info').toUpperCase() + '</span>'\n        + '</div>'\n        + '<div class=\"font-medium text-slate-800 text-sm mb-1\">' + (e.subject || '(Sans objet)') + '</div>'\n        + '<div class=\"text-xs text-slate-600\">' + (e.summary || '') + '</div>'\n        + actionHtml\n        + '</div>';\n    }).join('')\n  : '<div class=\"p-6 text-center text-sm text-slate-500 bg-slate-50 rounded-xl\">Aucun email prioritaire pour aujourd\\'hui.</div>';\n\nconst eventsHtml = events.length > 0\n  ? events.map(ev => {\n      const prepHtml = ev.preparationNeeded\n        ? '<div class=\"mt-2 text-xs text-indigo-700 bg-indigo-50 p-2 rounded border border-indigo-100\">📌 Préparation : ' + ev.preparationNeeded + '</div>'\n        : '';\n      return '<div class=\"flex gap-4 p-4 bg-white rounded-xl border border-slate-100 shadow-sm hover:shadow-md transition\">'\n        + '<div class=\"flex flex-col items-center justify-center min-w-[70px] bg-indigo-50 text-indigo-900 rounded-lg p-2 font-mono text-xs font-bold\">'\n        + '<span>' + (ev.startTime || '--:--') + '</span>'\n        + '<span class=\"text-[10px] text-indigo-500 font-normal\">à ' + (ev.endTime || '--:--') + '</span>'\n        + '</div>'\n        + '<div class=\"flex-1\">'\n        + '<div class=\"font-semibold text-slate-900 text-sm\">' + (ev.summary || 'Réunion') + '</div>'\n        + prepHtml\n        + '</div>'\n        + '</div>';\n    }).join('')\n  : '<div class=\"p-6 text-center text-sm text-slate-500 bg-slate-50 rounded-xl\">Aucun rendez-vous planifié dans l\\'agenda.</div>';\n\nconst prioritiesHtml = priorities.map((p, idx) => {\n  return '<li class=\"flex items-start gap-3 p-3 bg-indigo-50/50 rounded-lg border border-indigo-100 text-sm text-slate-800\">'\n    + '<span class=\"flex items-center justify-center w-5 h-5 rounded-full bg-indigo-600 text-white font-bold text-xs shrink-0\">' + (idx + 1) + '</span>'\n    + '<span>' + p + '</span>'\n    + '</li>';\n}).join('');\n\nconst correlationsHtml = correlations.length > 0\n  ? correlations.map(c => '<div class=\"p-3 bg-purple-50 border border-purple-200 text-purple-900 text-xs rounded-lg flex items-start gap-2\"><span>💡</span><span>' + c + '</span></div>').join('')\n  : '';\n\nconst html = '<!DOCTYPE html>'\n  + '<html lang=\"fr\">'\n  + '<head>'\n  + '<meta charset=\"UTF-8\">'\n  + '<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">'\n  + '<title>Executive Daily Briefing</title>'\n  + '<script src=\"https://cdn.tailwindcss.com\"></script>'\n  + '</head>'\n  + '<body class=\"bg-slate-50 text-slate-800 min-h-screen p-4 md:p-8\">'\n  + '<div class=\"max-w-6xl mx-auto space-y-6\">'\n  + '  <div class=\"bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white rounded-2xl p-6 md:p-8 shadow-xl border border-slate-800\">'\n  + '    <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">'\n  + '      <div>'\n  + '        <div class=\"text-xs uppercase tracking-widest text-indigo-400 font-semibold mb-1\">Système Multi-Agents Exécutif</div>'\n  + '        <h1 class=\"text-2xl md:text-3xl font-bold tracking-tight\">' + (synthesis.greeting || 'Briefing Quotidien') + '</h1>'\n  + '        <p class=\"text-sm text-slate-300 capitalize mt-1\">' + todayStr + ' • <span class=\"text-indigo-300 font-medium\">' + (synthesis.dailyTheme || '') + '</span></p>'\n  + '      </div>'\n  + '      <div class=\"flex items-center gap-2\">'\n  + '        <span class=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-emerald-500/20 text-emerald-300 border border-emerald-500/30\">'\n  + '          <span class=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\"></span> Synchronisé'\n  + '        </span>'\n  + '      </div>'\n  + '    </div>'\n  + '  </div>'\n  + '  <div class=\"grid grid-cols-2 md:grid-cols-4 gap-4\">'\n  + '    <div class=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm\">'\n  + '      <div class=\"text-xs font-semibold text-slate-500 uppercase tracking-wider\">Réunions</div>'\n  + '      <div class=\"text-2xl font-black text-indigo-600 mt-1\">' + (calendarData.totalMeetings || 0) + '</div>'\n  + '      <div class=\"text-xs text-slate-500 mt-0.5\">rendez-vous planifiés</div>'\n  + '    </div>'\n  + '    <div class=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm\">'\n  + '      <div class=\"text-xs font-semibold text-slate-500 uppercase tracking-wider\">Deep Work</div>'\n  + '      <div class=\"text-2xl font-black text-emerald-600 mt-1\">' + (calendarData.estimatedFocusHours || 0) + 'h</div>'\n  + '      <div class=\"text-xs text-slate-500 mt-0.5\">temps de concentration</div>'\n  + '    </div>'\n  + '    <div class=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm\">'\n  + '      <div class=\"text-xs font-semibold text-slate-500 uppercase tracking-wider\">Emails Traités</div>'\n  + '      <div class=\"text-2xl font-black text-slate-800 mt-1\">' + (emails.length || 0) + '</div>'\n  + '      <div class=\"text-xs text-slate-500 mt-0.5\">dernières 24h</div>'\n  + '    </div>'\n  + '    <div class=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm\">'\n  + '      <div class=\"text-xs font-semibold text-rose-600 uppercase tracking-wider\">Actions Urgentes</div>'\n  + '      <div class=\"text-2xl font-black text-rose-600 mt-1\">' + (emailData.urgentCount || 0) + '</div>'\n  + '      <div class=\"text-xs text-slate-500 mt-0.5\">priorité maximale</div>'\n  + '    </div>'\n  + '  </div>'\n  + '  <div class=\"bg-white rounded-2xl p-6 border border-slate-200 shadow-sm space-y-4\">'\n  + '    <div class=\"flex items-center gap-2\">'\n  + '      <span class=\"text-lg\">🎯</span>'\n  + '      <h2 class=\"text-base font-bold text-slate-900\">Priorités Absolues de la Journée</h2>'\n  + '    </div>'\n  + '    <ul class=\"space-y-2\">' + prioritiesHtml + '</ul>'\n  + (correlationsHtml ? '    <div class=\"pt-2 space-y-2\"><div class=\"text-xs font-semibold uppercase text-purple-800 tracking-wider\">Synergies & Corrélations Détectées</div>' + correlationsHtml + '</div>' : '')\n  + (synthesis.strategicAdvice ? '    <div class=\"p-3 bg-amber-50 border border-amber-200 text-amber-900 text-xs rounded-lg font-medium flex items-center gap-2\"><span>💡 Recommandation Stratégique :</span><span>' + synthesis.strategicAdvice + '</span></div>' : '')\n  + '  </div>'\n  + '  <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">'\n  + '    <div class=\"space-y-3\">'\n  + '      <div class=\"flex items-center justify-between\">'\n  + '        <h3 class=\"font-bold text-slate-900 text-sm flex items-center gap-2\"><span>📅</span> Agenda & Rendez-vous</h3>'\n  + '        <span class=\"text-xs text-slate-500 font-medium\">' + events.length + ' session(s)</span>'\n  + '      </div>'\n  + '      <div class=\"space-y-3\">' + eventsHtml + '</div>'\n  + '    </div>'\n  + '    <div class=\"space-y-3\">'\n  + '      <div class=\"flex items-center justify-between\">'\n  + '        <h3 class=\"font-bold text-slate-900 text-sm flex items-center gap-2\"><span>📬</span> Triage Intelligent des Emails</h3>'\n  + '        <span class=\"text-xs text-slate-500 font-medium\">' + emails.length + ' analysé(s)</span>'\n  + '      </div>'\n  + '      <div class=\"space-y-3\">' + emailRowsHtml + '</div>'\n  + '    </div>'\n  + '  </div>'\n  + (synthesis.motivationalQuote ? '  <div class=\"text-center text-xs text-slate-400 italic py-2\">« ' + synthesis.motivationalQuote + ' »</div>' : '')\n  + '</div>'\n  + '</body>'\n  + '</html>';\n\nreturn [{ json: { html: html, briefing: synthesis, emailTriage: emailData, calendarAgenda: calendarData } }];"
      }
    },
