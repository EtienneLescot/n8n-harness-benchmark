    {
      "id": "fb76bf27-7c01-4c98-a040-6c55b27b9333",
      "name": "Executive Synthesis Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1472,
        304
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Voici les résultats des deux agents spécialistes pour la journée :\n\n1. ANALYSE DES EMAILS :\n{{ JSON.stringify($(\"Email Triage Agent\").all()[0].json, null, 2) }}\n\n2. ANALYSE DU CALENDRIER :\n{{ JSON.stringify($(\"Calendar Agenda Agent\").all()[0].json, null, 2) }}\n\nSynthétise un briefing exécutif stratégique : croise les informations, établis les 3 priorités majeures, et formule des conseils pour maximiser l impact de la journée.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "Tu es le Chief of Staff et directeur exécutif IA. Tu reçois l analyse détaillée des emails par l agent Email et l analyse de l agenda par l agent Calendrier. Ton rôle est d établir des liens croisés (ex: un email qui prépare une réunion de l après-midi), de définir la stratégie du jour et les priorités absolues avec clarté, élégance et proactivité."
        }
      }
    },
    {
      "id": "0eb338a4-6f79-4376-b89d-63b5ca60fd07",
