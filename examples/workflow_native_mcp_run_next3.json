    {
      "id": "8f132302-c0f0-4990-8a33-750a68a2899f",
      "name": "Format Calendar For Agent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        512
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst validEvents = [];\nfor (const item of items) {\n  const j = item.json;\n  if (j && (j.summary || j.id)) {\n    validEvents.push({\n      summary: j.summary || '(Sans titre)',\n      start: j.start?.dateTime || j.start?.date || '',\n      end: j.end?.dateTime || j.end?.date || '',\n      description: j.description || '',\n      organizer: j.organizer?.email || ''\n    });\n  }\n}\nreturn [{\n  json: {\n    eventCount: validEvents.length,\n    rawEvents: validEvents,\n    agentPrompt: validEvents.length > 0\n      ? 'Voici les ' + validEvents.length + ' événements du calendrier d aujourd hui :\\n' + JSON.stringify(validEvents, null, 2)\n      : 'Aucun événement prévu dans le calendrier aujourd hui.'\n  }\n}];"
      }
    },
