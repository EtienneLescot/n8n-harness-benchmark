    {
      "id": "f0d6cfc9-240a-498a-a1ef-62782be07575",
      "name": "Format Emails For Agent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        112
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst validEmails = [];\nfor (const item of items) {\n  const j = item.json;\n  if (j && (j.Subject || j.subject || j.snippet || j.From || j.from)) {\n    validEmails.push({\n      from: j.From || j.from || 'Inconnu',\n      subject: j.Subject || j.subject || '(Sans objet)',\n      snippet: j.snippet || '',\n      date: j.internalDate || ''\n    });\n  }\n}\nreturn [{\n  json: {\n    emailCount: validEmails.length,\n    rawEmails: validEmails,\n    agentPrompt: validEmails.length > 0\n      ? 'Voici les ' + validEmails.length + ' emails reçus aujourd hui à trier et analyser :\\n' + JSON.stringify(validEmails, null, 2)\n      : 'Aucun nouvel email reçu sur les dernières 24h.'\n  }\n}];"
      }
    },
    {
