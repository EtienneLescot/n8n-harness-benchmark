{
  "name": "Daily Briefing & Multi-Agent Triage Dashboard",
  "nodes": [
    {
      "id": "1",
      "name": "Daily Schedule Trigger (8:00 AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [100, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "2",
      "name": "Fetch Daily Google Mails",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [360, 180],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 20,
        "filters": {
          "q": "newer_than:1d is:unread"
        }
      }
    },
    {
      "id": "3",
      "name": "Fetch Today Google Calendar Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [360, 440],
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "list"
        },
        "timeMin": "={{ $today.startOf('day').toISO() }}",
        "timeMax": "={{ $today.endOf('day').toISO() }}"
      }
    },
    {
      "id": "4",
      "name": "Merge Ingested Feeds",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [620, 300],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll"
      }
    },
    {
      "id": "5",
      "name": "Multi-Agent Daily Triage & Synthesis",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [900, 300],
      "parameters": {
        "promptType": "define",
        "text": "You are the Executive AI Daily Chief of Staff. Triage the incoming unread emails and today's calendar schedule into:\n1. URGENT ACTION ITEMS (High priority emails requiring immediate reply or decision)\n2. SCHEDULE & PREP (Meetings, conflict detection, buffer time warnings, preparation notes)\n3. GENERAL DIGEST (Low-priority updates, newsletters, FYI)\n4. EXECUTIVE DAILY SUMMARY (A 3-sentence high-level overview for today).\n\nOutput a structured JSON with keys: executiveSummary, urgentItems, calendarAgenda, lowPriorityDigest, totalEmailsAnalyzed, totalMeetingsToday.",
        "hasOutputParser": true
      }
    },
    {
      "id": "6",
      "name": "AI Language Model (Gemini / OpenAI)",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [900, 520],
      "parameters": {
        "modelName": "gemini-2.5-flash",
        "options": {
          "temperature": 0.2
        }
      }
    },
    {
      "id": "7",
      "name": "Generate HTML Dashboard of the Day",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [1200, 300],
      "parameters": {
        "operation": "generateHtmlTemplate",
        "dataPropertyName": "data",
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Daily Briefing & Triage Dashboard</title>\n  <style>\n    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #0f172a; color: #f8fafc; margin: 0; padding: 32px 20px; line-height: 1.6; }\n    .container { max-width: 900px; margin: 0 auto; }\n    .header { background: linear-gradient(135deg, #2563eb, #7c3aed); border-radius: 16px; padding: 32px; margin-bottom: 28px; box-shadow: 0 10px 25px -5px rgba(37, 99, 235, 0.3); }\n    .date-badge { display: inline-block; background: rgba(255, 255, 255, 0.2); padding: 4px 12px; border-radius: 9999px; font-size: 0.85rem; font-weight: 600; text-transform: uppercase; margin-bottom: 8px; }\n    h1 { margin: 0 0 10px 0; font-size: 2rem; font-weight: 800; }\n    .summary-text { font-size: 1.05rem; color: #e2e8f0; margin: 0; }\n    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px; }\n    .card { background: #1e293b; border: 1px solid #334155; border-radius: 14px; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }\n    .card-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }\n    .badge { padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }\n    .badge-urgent { background: #ef4444; color: white; }\n    .badge-cal { background: #3b82f6; color: white; }\n    .stat-box { display: flex; gap: 16px; margin-top: 16px; }\n    .stat-item { background: #0f172a; padding: 12px 16px; border-radius: 8px; border: 1px solid #334155; flex: 1; text-align: center; }\n    .stat-num { font-size: 1.5rem; font-weight: 800; color: #38bdf8; }\n    .stat-label { font-size: 0.75rem; color: #94a3b8; text-transform: uppercase; }\n    ul { margin: 0; padding-left: 20px; }\n    li { margin-bottom: 8px; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <div class=\"date-badge\">{{ $today.toFormat('cccc, LLLL d, yyyy') }}</div>\n      <h1>🌅 Executive Daily Briefing</h1>\n      <p class=\"summary-text\">{{ $json.executiveSummary }}</p>\n      <div class=\"stat-box\">\n        <div class=\"stat-item\">\n          <div class=\"stat-num\">{{ $json.totalEmailsAnalyzed || 0 }}</div>\n          <div class=\"stat-label\">Emails Analyzed</div>\n        </div>\n        <div class=\"stat-item\">\n          <div class=\"stat-num\">{{ $json.totalMeetingsToday || 0 }}</div>\n          <div class=\"stat-label\">Meetings Today</div>\n        </div>\n      </div>\n    </div>\n    <div class=\"grid\">\n      <div class=\"card\">\n        <div class=\"card-title\">\n          <span class=\"badge badge-urgent\">Urgent</span>\n          🚨 Action Items Required\n        </div>\n        <div>{{ $json.urgentItems }}</div>\n      </div>\n      <div class=\"card\">\n        <div class=\"card-title\">\n          <span class=\"badge badge-cal\">Schedule</span>\n          📅 Today's Agenda & Conflicts\n        </div>\n        <div>{{ $json.calendarAgenda }}</div>\n      </div>\n    </div>\n    <div class=\"card\">\n      <div class=\"card-title\">📰 Low-Priority & Informational Digest</div>\n      <div>{{ $json.lowPriorityDigest }}</div>\n    </div>\n  </div>\n</body>\n</html>"
      }
    }
  ],
  "connections": {
    "Daily Schedule Trigger (8:00 AM)": {
      "main": [
        [
          {
            "node": "Fetch Daily Google Mails",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Today Google Calendar Events",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Daily Google Mails": {
      "main": [
        [
          {
            "node": "Merge Ingested Feeds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Today Google Calendar Events": {
      "main": [
        [
          {
            "node": "Merge Ingested Feeds",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Merge Ingested Feeds": {
      "main": [
        [
          {
            "node": "Multi-Agent Daily Triage & Synthesis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Language Model (Gemini / OpenAI)": {
      "ai_languageModel": [
        [
          {
            "node": "Multi-Agent Daily Triage & Synthesis",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Multi-Agent Daily Triage & Synthesis": {
      "main": [
        [
          {
            "node": "Generate HTML Dashboard of the Day",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
