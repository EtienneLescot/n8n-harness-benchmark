{
  "id": "HakV7bOZlGBwGTre",
  "name": "Daily Briefing & Multi-Agent Triage Dashboard [Benchmark-NativeMCP]",
  "description": null,
  "active": false,
  "activeVersionId": null,
  "createdAt": "2026-09-06T12:29:31.767Z",
