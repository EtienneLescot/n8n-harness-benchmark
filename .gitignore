# Dependencies
node_modules/

# Environment files with secrets
.env
.env.local
.env.benchmark

# Sandbox execution data
benchmark/sandboxes/*
!benchmark/sandboxes/.gitkeep

# System & OS
.DS_Store
Thumbs.db
*.log

# Probe sandboxes and packed artifacts: run debris, never source
benchmark/install-probe/sandboxes/
benchmark/artifacts/

# Generated reports live in results/ and docs/, not here
benchmark/reports/

# Probe results are per-run debris, regenerated by probe.mjs on the next scoring pass
benchmark/install-probe/results.json
