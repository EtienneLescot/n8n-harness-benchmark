{"id":"7jYlI9lz6LwhGyHA","name":"bench-f024f288","description":null,"active":false,"activeVersionId":null,"createdAt":"2026-09-09T13:22:34.946Z","updatedAt":"2026-09-09T13:22:34.946Z","isArchived":false,"versionId":"47e14604-a9fd-4093-a64d-49abda1a2ed2","versionCounter":1,"sourceWorkflowId":null,"triggerCount":0,"nodes":[{"id":"6de8dc0e-e6df-4cbe-bb0b-ca00b2373b79","name":"Daily Morning Trigger","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.4,"position":[-240,0],"parameters":{"rule":{"interval":[{"field":"days","daysInterval":1,"triggerAtHour":7,"triggerAtMinute":0}]}}},{"id":"0861597c-3630-40da-aa44-28c8b788af0c","name":"Fetch Overnight Emails","type":"n8n-nodes-base.gmail","typeVersion":2.2,"alwaysOutputData":true,"position":[-20,0],"parameters":{"resource":"message","operation":"getAll","returnAll":false,"limit":50,"simple":true,"filters":{"q":"newer_than:1d","includeSpamTrash":false}},"webhookId":"bfe02d40-d9ab-469b-bb91-557c85fb10cc"},{"id":"827bbcac-47e0-4348-97ed-db33c7d2ec50","name":"Collect Emails","type":"n8n-nodes-base.aggregate","typeVersion":1,"position":[200,0],"parameters":{"aggregate":"aggregateAllItemData","destinationFieldName":"emails","include":"allFields"}},{"id":"68f9dbe0-f541-4dac-b49a-b0582913bd88","name":"Email Triage Agent","type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"position":[420,0],"parameters":{"promptType":"define","text":"=Overnight mail as JSON:\n\n{{ JSON.stringify($json.emails) }}","options":{"systemMessage":"You are the Inbox Triage agent of a daily briefing crew. Sort the emails you are given into three buckets: NEEDS REPLY TODAY, WORTH KNOWING, NOISE. For each kept email give sender, subject and one short line saying why it matters. Drop nothing into a bucket you cannot justify from the data. Never invent an email. If the list is empty, answer exactly \"No new mail.\" Answer in plain text, no HTML, no markdown fences."}}},{"id":"650a9fd3-07bf-436a-8a97-90698c593a8f","name":"Fetch Todays Events","type":"n8n-nodes-base.googleCalendar","typeVersion":1.3,"alwaysOutputData":true,"position":[640,0],"parameters":{"resource":"event","operation":"getAll","calendar":{"__rl":true,"value":"primary","mode":"list","cachedResultName":"primary"},"returnAll":false,"limit":50,"timeMin":"={{ $now.startOf(\"day\").toISO() }}","timeMax":"={{ $now.endOf(\"day\").toISO() }}","options":{"singleEvents":true}}},{"id":"8df10609-4e90-4582-811b-abfa2a05f8f1","name":"Collect Events","type":"n8n-nodes-base.aggregate","typeVersion":1,"position":[860,0],"parameters":{"aggregate":"aggregateAllItemData","destinationFieldName":"events","include":"allFields"}},{"id":"20bf0651-2597-4e88-80dc-9a43c6c4a409","name":"Schedule Analyst Agent","type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"position":[1080,0],"parameters":{"promptType":"define","text":"=Today is {{ $now.toFormat(\"cccc d LLLL yyyy\") }}.\n\nToday's calendar events as JSON:\n\n{{ JSON.stringify($json.events) }}","options":{"systemMessage":"You are the Schedule Analyst of a daily briefing crew. From the calendar events given, produce: a chronological list (start time, end time, title, location or meeting link, attendee count), then the first free block longer than 60 minutes, then any conflict where two events overlap. Use only the data given, never invent an event. If there are no events, answer exactly \"Nothing scheduled.\" Answer in plain text, no HTML, no markdown fences."}}},{"id":"f3c82089-32df-4e49-a25d-e7441b9df5c4","name":"Briefing Composer Agent","type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"position":[1300,0],"parameters":{"promptType":"define","text":"=Date: {{ $now.toFormat(\"cccc d LLLL yyyy\") }}\n\n--- INBOX TRIAGE ---\n{{ $('Email Triage Agent').first().json.output }}\n\n--- SCHEDULE ANALYSIS ---\n{{ $json.output }}","options":{"systemMessage":"You are the Editor of a daily briefing crew. Turn the two analyst reports into ONE self-contained HTML dashboard. Output raw HTML only: no markdown, no code fences, no commentary before or after. Structure: <h1> with the date; a row of summary cards (emails needing a reply, meetings today, first free block); a \"Needs reply today\" section; a \"Worth knowing\" section; a \"Today's schedule\" section as a table with time, title, location; a \"Watch out\" section for conflicts. Use inline CSS only (email clients strip <style>), a light background, system font stack, max-width 680px centred. Restate only facts present in the reports."}}},{"id":"dd4525ee-c377-4a26-93a5-d9c089f49d3c","name":"Shared Chat Model","type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","typeVersion":1.3,"position":[860,240],"parameters":{"model":{"__rl":true,"value":"gpt-5-mini","mode":"list","cachedResultName":"gpt-5-mini"}}},{"id":"96ccd297-9a49-431c-ad1f-9dac016807fb","name":"Send Briefing Dashboard","type":"n8n-nodes-base.gmail","typeVersion":2.2,"position":[1520,0],"parameters":{"resource":"message","operation":"send","sendTo":"change-me@example.com","subject":"=Daily briefing - {{ $now.toFormat(\"cccc d LLLL yyyy\") }}","emailType":"html","message":"={{ $json.output.replace(/^\\s*```(?:html)?|```\\s*$/g, \"\") }}","options":{"appendAttribution":false}},"webhookId":"bc3cd4ae-bb31-403d-ad4d-6b0f2c2dbfe8"}],"connections":{"Daily Morning Trigger":{"main":[[{"node":"Fetch Overnight Emails","type":"main","index":0}]]},"Fetch Overnight Emails":{"main":[[{"node":"Collect Emails","type":"main","index":0}]]},"Collect Emails":{"main":[[{"node":"Email Triage Agent","type":"main","index":0}]]},"Email Triage Agent":{"main":[[{"node":"Fetch Todays Events","type":"main","index":0}]]},"Fetch Todays Events":{"main":[[{"node":"Collect Events","type":"main","index":0}]]},"Collect Events":{"main":[[{"node":"Schedule Analyst Agent","type":"main","index":0}]]},"Schedule Analyst Agent":{"main":[[{"node":"Briefing Composer Agent","type":"main","index":0}]]},"Briefing Composer Agent":{"main":[[{"node":"Send Briefing Dashboard","type":"main","index":0}]]},"Shared Chat Model":{"ai_languageModel":[[{"node":"Email Triage Agent","type":"ai_languageModel","index":0},{"node":"Schedule Analyst Agent","type":"ai_languageModel","index":0},{"node":"Briefing Composer Agent","type":"ai_languageModel","index":0}]]}},"nodeGroups":[],"settings":{"executionOrder":"v1","availableInMCP":true},"staticData":null,"pinData":null,"meta":null,"tags":[],"shared":[{"role":"workflow:owner","workflowId":"7jYlI9lz6LwhGyHA","projectId":"sD2aDWI5bIJF3Km3","project":{"id":"sD2aDWI5bIJF3Km3","name":"Etienne Lescot <etienne@etiennelescot.fr>","type":"personal","icon":null,"description":null,"customTelemetryTags":[],"creatorId":"bc580dc4-c80d-4df9-8103-c062f04c8b11","createdAt":"2025-12-17T14:24:27.408Z","updatedAt":"2025-12-17T14:24:37.777Z"},"createdAt":"2026-09-09T13:22:34.950Z","updatedAt":"2026-09-09T13:22:34.950Z"}],"activeVersion":null}