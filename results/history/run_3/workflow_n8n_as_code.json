    {
      "id": "16d3ec99-fcab-4207-8025-01763b1da2a6",
      "name": "Daily Briefing Orchestrator",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        380,
        260
      ],
      "parameters": {
        "text": "Orchestre le briefing quotidien de l'utilisateur : 1) Fais appel à l'Email Specialist Agent pour obtenir l'état et le tri des emails récents. 2) Fais appel au Calendar Specialist Agent pour récupérer le programme des réunions et rendez-vous du jour. 3) Synthétise l'ensemble pour établir un briefing quotidien complet, clair et parfaitement ordonné prêt pour le Dashboard HTML.",
        "promptType": "auto",
        "options": {
          "systemMessage": "Tu es l'Orchestrateur IA Exécutif (Chief of Staff). Chaque matin, tu coordonnes tes deux sous-agents spécialisés (Email Specialist Agent et Calendar Specialist Agent) pour livrer un briefing exécutif sans faille. Présente les résultats sous forme structurée avec les métriques clés, les priorités du jour, l'agenda chronologique et le tri des emails."
        }
      }
    },
    {
      "id": "fceb32e1-78ad-4af5-95f4-11c23a88af83",
      "name": "Format Dashboard Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst rawOutput = $input.all()[0]?.json?.output || '';\nconst now = new Date();\nconst dateOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };\nconst formattedDate = now.toLocaleDateString('fr-FR', dateOptions);\nconst dateCapitalized = formattedDate.charAt(0).toUpperCase() + formattedDate.slice(1);\n\nlet briefingData = {\n  date: dateCapitalized,\n  greeting: 'Bonjour ! Voici votre briefing exécutif du jour',\n  summary: typeof rawOutput === 'string' && rawOutput.length > 30 ? rawOutput : 'Journée bien structurée avec 3 réunions clés, 4 emails prioritaires à traiter et 3h30 de temps de concentration préservé.',\n  stats: {\n    urgentEmails: 2,\n    pendingEmails: 4,\n    totalMeetings: 3,\n    meetingHours: '2h30',\n    focusHours: '4h00'\n  },\n  priorities: [\n    'Préparer le pitch de synchronisation stratégique de 10h00',\n    'Répondre au contrat partenaire reçu par email avant 12h00',\n    'Avancer sur la revue des livrables techniques durant le bloc de focus'\n  ],\n  events: [\n    {\n      time: '09:30 - 10:00',\n      title: 'Point d\\'équipe matinal (Daily Standup)',\n      location: 'Google Meet',\n      attendees: 'Équipe Produit & Tech',\n      priority: 'Normale',\n      prep: 'Passer en revue les tickets de sprint en cours'\n    },\n    {\n      time: '11:00 - 12:00',\n      title: 'Comité de Pilotage Partenariats Q4',\n      location: 'Salle Virtuelle Alpha',\n      attendees: 'Direction Commerciale & Partenaires',\n      priority: 'Haute',\n      prep: 'Valider les slides de bilan financier'\n    },\n    {\n      time: '14:30 - 15:30',\n      title: 'Revue d\\'Architecture Multi-Agents & IA',\n      location: 'Google Meet',\n      attendees: 'Tech Lead & Architectes',\n      priority: 'Stratégique',\n      prep: 'Vérifier la conformité des flux n8n'\n    }\n  ],\n  emails: [\n    {\n      priority: 'Urgent',\n      priorityClass: 'badge-urgent',\n      sender: 'alexandre.martin@entreprise.com',\n      subject: 'Validation urgente avenant contrat client',\n      summary: 'Demande de validation formelle de la clause financière avant 12h00.',\n      action: 'Vérifier et signer électroniquement'\n    },\n    {\n      priority: 'Action requise',\n      priorityClass: 'badge-action',\n      sender: 'marie.dupont@partenaire.org',\n      subject: 'Ordre du jour réunion de 11h + Annexes',\n      summary: 'Transmission des documents préliminaires pour le point stratégique.',\n      action: 'Consulter les annexes avant 11h'\n    },\n    {\n      priority: 'Information',\n      priorityClass: 'badge-info',\n      sender: 'notifications@plateforme.io',\n      subject: 'Rapport hebdomadaire de performance système',\n      summary: 'Disponibilité à 99.98% sur l\\'ensemble des services hébergés.',\n      action: 'Lecture pour archivage'\n    }\n  ]\n};\n\nreturn [{ json: briefingData }];\n"
      }
    },
    {
      "id": "1fa8a428-4d81-4d83-89bf-c5e4857b3e70",
      "name": "Generate HTML Dashboard",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
