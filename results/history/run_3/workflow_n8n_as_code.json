      "parameters": {
        "operation": "generateHtmlTemplate",
        "dataPropertyName": "html",
        "html": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Dashboard Quotidien Exécutif</title>\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body {\n      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n      background-color: #0f172a;\n      color: #e2e8f0;\n      line-height: 1.6;\n      padding: 24px 16px;\n    }\n    .wrapper {\n      max-width: 860px;\n      margin: 0 auto;\n      background-color: #1e293b;\n      border-radius: 16px;\n      overflow: hidden;\n      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4), 0 8px 10px -6px rgba(0, 0, 0, 0.3);\n      border: 1px solid #334155;\n    }\n    .header {\n      background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 50%, #0f172a 100%);\n      padding: 32px 28px;\n      color: #ffffff;\n    }\n    .header-top {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 12px;\n    }\n    .badge-date {\n      background: rgba(255, 255, 255, 0.18);\n      padding: 6px 14px;\n      border-radius: 20px;\n      font-size: 13px;\n      font-weight: 600;\n      backdrop-filter: blur(8px);\n      letter-spacing: 0.3px;\n    }\n    .badge-status {\n      background: #10b981;\n      color: #ffffff;\n      padding: 4px 10px;\n      border-radius: 12px;\n      font-size: 11px;\n      font-weight: 700;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n    }\n    .header h1 {\n      font-size: 26px;\n      font-weight: 800;\n      margin-bottom: 8px;\n      letter-spacing: -0.5px;\n    }\n    .header p {\n      font-size: 14px;\n      color: #bfdbfe;\n      max-width: 650px;\n    }\n    .metrics-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));\n      gap: 14px;\n      padding: 24px 28px 10px;\n    }\n    .metric-card {\n      background: #0f172a;\n      border: 1px solid #334155;\n      padding: 16px;\n      border-radius: 12px;\n      text-align: center;\n    }\n    .metric-value {\n      font-size: 24px;\n      font-weight: 800;\n      color: #f8fafc;\n      margin-bottom: 4px;\n    }\n    .metric-label {\n      font-size: 11px;\n      text-transform: uppercase;\n      font-weight: 600;\n      color: #94a3b8;\n      letter-spacing: 0.5px;\n    }\n    .val-urgent { color: #f87171; }\n    .val-action { color: #fbbf24; }\n    .val-calendar { color: #60a5fa; }\n    .val-focus { color: #34d399; }\n    .content-section {\n      padding: 18px 28px;\n    }\n    .section-title {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      font-size: 16px;\n      font-weight: 700;\n      color: #f1f5f9;\n      margin-bottom: 14px;\n      padding-bottom: 8px;\n      border-bottom: 1px solid #334155;\n    }\n    .section-title span.icon {\n      font-size: 18px;\n    }\n    .priority-list {\n      list-style: none;\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n    }\n    .priority-item {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      background: #0f172a;\n      border: 1px solid #334155;\n      padding: 12px 16px;\n      border-radius: 10px;\n      font-size: 14px;\n    }\n    .priority-num {\n      background: #3b82f6;\n      color: #ffffff;\n      width: 22px;\n      height: 22px;\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 11px;\n      font-weight: 700;\n      flex-shrink: 0;\n    }\n    .timeline {\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n    }\n    .event-card {\n      background: #0f172a;\n      border-left: 4px solid #3b82f6;\n      border-radius: 0 10px 10px 0;\n      padding: 14px 16px;\n      border-top: 1px solid #334155;\n      border-right: 1px solid #334155;\n      border-bottom: 1px solid #334155;\n    }\n    .event-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 6px;\n    }\n    .event-time {\n      font-size: 13px;\n      font-weight: 700;\n      color: #60a5fa;\n    }\n    .event-title {\n      font-size: 15px;\n      font-weight: 600;\n      color: #f8fafc;\n      margin-bottom: 4px;\n    }\n    .event-details {\n      font-size: 12px;\n      color: #94a3b8;\n    }\n    .emails-table {\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n    }\n    .email-card {\n      background: #0f172a;\n      border: 1px solid #334155;\n      border-radius: 10px;\n      padding: 14px 16px;\n    }\n    .email-top {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 6px;\n    }\n    .email-sender {\n      font-size: 13px;\n      font-weight: 600;\n      color: #cbd5e1;\n    }\n    .pill {\n      font-size: 11px;\n      font-weight: 700;\n      padding: 3px 8px;\n      border-radius: 12px;\n      text-transform: uppercase;\n    }\n    .pill-urgent { background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid #ef4444; }\n    .pill-action { background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid #f59e0b; }\n    .pill-info { background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid #10b981; }\n    .email-subject {\n      font-size: 14px;\n      font-weight: 600;\n      color: #f8fafc;\n      margin-bottom: 4px;\n    }\n    .email-summary {\n      font-size: 13px;\n      color: #94a3b8;\n      margin-bottom: 6px;\n    }\n    .email-action {\n      font-size: 12px;\n      color: #38bdf8;\n      font-weight: 500;\n    }\n    .footer {\n      background: #0f172a;\n      border-top: 1px solid #334155;\n      padding: 20px 28px;\n      text-align: center;\n      font-size: 12px;\n      color: #64748b;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"wrapper\">\n    <div class=\"header\">\n      <div class=\"header-top\">\n        <span class=\"badge-date\">{{ $json.date }}</span>\n        <span class=\"badge-status\">Synchronisé</span>\n      </div>\n      <h1>{{ $json.greeting }}</h1>\n      <p>{{ $json.summary }}</p>\n    </div>\n\n    <div class=\"metrics-grid\">\n      <div class=\"metric-card\">\n        <div class=\"metric-value val-urgent\">{{ $json.stats.urgentEmails }}</div>\n        <div class=\"metric-label\">Urgences Email</div>\n      </div>\n      <div class=\"metric-card\">\n        <div class=\"metric-value val-action\">{{ $json.stats.pendingEmails }}</div>\n        <div class=\"metric-label\">Emails à traiter</div>\n      </div>\n      <div class=\"metric-card\">\n        <div class=\"metric-value val-calendar\">{{ $json.stats.totalMeetings }}</div>\n        <div class=\"metric-label\">Réunions du jour</div>\n      </div>\n      <div class=\"metric-card\">\n        <div class=\"metric-value val-calendar\">{{ $json.stats.meetingHours }}</div>\n        <div class=\"metric-label\">Temps de réunion</div>\n      </div>\n      <div class=\"metric-card\">\n        <div class=\"metric-value val-focus\">{{ $json.stats.focusHours }}</div>\n        <div class=\"metric-label\">Heures de Focus</div>\n      </div>\n    </div>\n\n    <div class=\"content-section\">\n      <div class=\"section-title\">\n        <span class=\"icon\">🎯</span> Top 3 Priorités Stratégiques du Jour\n      </div>\n      <ul class=\"priority-list\">\n        <li class=\"priority-item\"><span class=\"priority-num\">1</span> {{ $json.priorities[0] }}</li>\n        <li class=\"priority-item\"><span class=\"priority-num\">2</span> {{ $json.priorities[1] }}</li>\n        <li class=\"priority-item\"><span class=\"priority-num\">3</span> {{ $json.priorities[2] }}</li>\n      </ul>\n    </div>\n\n    <div class=\"content-section\">\n      <div class=\"section-title\">\n        <span class=\"icon\">📅</span> Agenda & Réunions Google Calendar\n      </div>\n      <div class=\"timeline\">\n        <div class=\"event-card\">\n          <div class=\"event-header\">\n            <span class=\"event-time\">{{ $json.events[0].time }}</span>\n            <span class=\"pill pill-info\">{{ $json.events[0].priority }}</span>\n          </div>\n          <div class=\"event-title\">{{ $json.events[0].title }}</div>\n          <div class=\"event-details\">📍 {{ $json.events[0].location }} • 👥 {{ $json.events[0].attendees }} • 💡 {{ $json.events[0].prep }}</div>\n        </div>\n        <div class=\"event-card\">\n          <div class=\"event-header\">\n            <span class=\"event-time\">{{ $json.events[1].time }}</span>\n            <span class=\"pill pill-urgent\">{{ $json.events[1].priority }}</span>\n          </div>\n          <div class=\"event-title\">{{ $json.events[1].title }}</div>\n          <div class=\"event-details\">📍 {{ $json.events[1].location }} • 👥 {{ $json.events[1].attendees }} • 💡 {{ $json.events[1].prep }}</div>\n        </div>\n        <div class=\"event-card\">\n          <div class=\"event-header\">\n            <span class=\"event-time\">{{ $json.events[2].time }}</span>\n            <span class=\"pill pill-action\">{{ $json.events[2].priority }}</span>\n          </div>\n          <div class=\"event-title\">{{ $json.events[2].title }}</div>\n          <div class=\"event-details\">📍 {{ $json.events[2].location }} • 👥 {{ $json.events[2].attendees }} • 💡 {{ $json.events[2].prep }}</div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"content-section\">\n      <div class=\"section-title\">\n        <span class=\"icon\">✉️</span> Boîte Gmail & Tri Intelligent\n      </div>\n      <div class=\"emails-table\">\n        <div class=\"email-card\">\n          <div class=\"email-top\">\n            <span class=\"email-sender\">👤 {{ $json.emails[0].sender }}</span>\n            <span class=\"pill pill-urgent\">{{ $json.emails[0].priority }}</span>\n          </div>\n          <div class=\"email-subject\">{{ $json.emails[0].subject }}</div>\n          <div class=\"email-summary\">{{ $json.emails[0].summary }}</div>\n          <div class=\"email-action\">⚡ Action requise : {{ $json.emails[0].action }}</div>\n        </div>\n        <div class=\"email-card\">\n          <div class=\"email-top\">\n            <span class=\"email-sender\">👤 {{ $json.emails[1].sender }}</span>\n            <span class=\"pill pill-action\">{{ $json.emails[1].priority }}</span>\n          </div>\n          <div class=\"email-subject\">{{ $json.emails[1].subject }}</div>\n          <div class=\"email-summary\">{{ $json.emails[1].summary }}</div>\n          <div class=\"email-action\">⚡ Action requise : {{ $json.emails[1].action }}</div>\n        </div>\n        <div class=\"email-card\">\n          <div class=\"email-top\">\n            <span class=\"email-sender\">👤 {{ $json.emails[2].sender }}</span>\n            <span class=\"pill pill-info\">{{ $json.emails[2].priority }}</span>\n          </div>\n          <div class=\"email-subject\">{{ $json.emails[2].subject }}</div>\n          <div class=\"email-summary\">{{ $json.emails[2].summary }}</div>\n          <div class=\"email-action\">⚡ Action requise : {{ $json.emails[2].action }}</div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"footer\">\n      Généré automatiquement par le Système Multi-Agents n8n (Daily Orchestrator, Email Specialist & Calendar Specialist)\n    </div>\n  </div>\n</body>\n</html>"
