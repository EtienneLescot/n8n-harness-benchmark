    {
      "id": "n12",
      "name": "Dashboard Composer Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        40,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ 'EMAIL SUMMARY:\\n' + $json.emailSummary + '\\n\\nCALENDAR SUMMARY:\\n' + $json.calendarSummary }}",
        "options": {
          "systemMessage": "You are a dashboard designer. You receive a sorted email summary and a sorted calendar summary. Combine them into a single, self-contained HTML page (inline CSS, no external assets) titled 'Daily Briefing'. Include today's date, a calendar section listing the day's events in order, and an email section broken out by category. Output ONLY the raw HTML document, nothing else, no markdown code fences."
        }
      }
    },
