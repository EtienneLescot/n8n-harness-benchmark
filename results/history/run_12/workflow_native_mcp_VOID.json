      "id": "n6",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        -680,
        650
      ],
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {}
      }
    },
    {
      "id": "n7",
      "name": "Email Sorter Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -680,
        180
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json.items) }}",
        "options": {
          "systemMessage": "You are an email triage assistant. You receive today's Gmail messages as JSON (subject, sender, snippet, date). Sort them into categories: Urgent, Action Needed, FYI, and Newsletters/Promotions. Return a concise categorized summary in markdown, with the sender and subject for each item."
        }
      }
    },
    {
      "id": "n8",
      "name": "Calendar Sorter Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -680,
        420
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json.items) }}",
        "options": {
          "systemMessage": "You are a calendar assistant. You receive today's Google Calendar events as JSON. Sort them chronologically, flag any overlapping or back-to-back meetings, and return a concise summary in markdown with start time, end time, and title for each event."
        }
      }
    },
    {
      "id": "n9",
      "name": "Rename Email Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
