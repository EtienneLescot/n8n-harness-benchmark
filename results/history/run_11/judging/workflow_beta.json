  "nodes": [
    {
      "name": "Daily Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 7,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "name": "Get Today's Emails",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        300,
        120
      ],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 50,
        "filters": {
          "q": "newer_than:1d"
        }
      }
    },
    {
      "name": "Get Today's Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.2,
      "position": [
        300,
        480
      ],
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": "primary",
          "cachedResultName": "primary"
        },
        "timeMin": "={{ $now.startOf('day').toISO() }}",
        "timeMax": "={{ $now.endOf('day').toISO() }}",
        "options": {}
      }
    },
    {
      "name": "Chat Model (Email Agent)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        480,
        -20
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {}
      }
    },
    {
      "name": "Email Sorting Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        560,
        120
      ],
      "parameters": {
        "promptType": "define",
        "text": "=You are given raw Gmail messages as JSON: {{ JSON.stringify($json) }}. Sort them into categories: Urgent, Action Needed, FYI, Newsletter/Promo. Return ONLY a JSON array of objects: {category, subject, from, snippet}.",
        "options": {
          "systemMessage": "You are an email triage assistant for a daily briefing. Be concise and return valid JSON only, no commentary."
        }
      }
    },
    {
      "name": "Chat Model (Calendar Agent)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        480,
        340
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {}
      }
    },
    {
      "name": "Calendar Sorting Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        560,
        480
      ],
      "parameters": {
        "promptType": "define",
        "text": "=You are given today's Google Calendar events as JSON: {{ JSON.stringify($json) }}. Sort them chronologically and flag any conflicts or back-to-back meetings. Return ONLY a JSON array of objects: {time, title, location, flag}.",
        "options": {
          "systemMessage": "You are a calendar assistant for a daily briefing. Be concise and return valid JSON only, no commentary."
        }
      }
    },
    {
      "name": "Merge Sorted Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.1,
      "position": [
        820,
        300
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      }
    },
    {
      "name": "Chat Model (Dashboard Agent)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1000,
        160
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {}
      }
    },
    {
      "name": "Briefing Composer Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        1060,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Using the sorted email categories and sorted calendar events below, produce a complete, self-contained HTML daily briefing dashboard (inline CSS, no external assets, no markdown fences). Include sections for Today's Schedule, Urgent Emails, Action Needed, and FYI/Newsletters. Data: {{ JSON.stringify($json) }}",
        "options": {
          "systemMessage": "You are a dashboard designer. Output ONLY a complete HTML document, no markdown fences, no commentary."
        }
      }
    },
    {
      "name": "Send Daily Briefing",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "REPLACE_WITH_YOUR_EMAIL@example.com",
        "subject": "=Daily Briefing - {{ $now.format('yyyy-LL-dd') }}",
        "message": "={{ $json.output }}",
        "options": {
          "appendAttribution": false
        }
      }
    }
