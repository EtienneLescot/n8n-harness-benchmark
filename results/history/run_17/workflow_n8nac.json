    {
      "id": "fbe7a7e7-fe94-4c62-84c2-aeb4be101bc3",
      "name": "Briefing Director Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1440,
        400
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify({ emailAnalysis: $json.emailAnalysis, calendarAnalysis: $json.calendarAnalysis }) }}",
        "options": {
          "systemMessage": "You are the Briefing Director Agent leading a multi-agent daily briefing team.\nYou receive two analyst reports in a JSON object: emailAnalysis (sorted email briefing) and calendarAnalysis (sorted day agenda).\nCompose ONE polished, self-contained HTML daily briefing dashboard as a single HTML document:\n- Start with <!DOCTYPE html> and include a <head> with embedded <style> (modern dark dashboard look, cards, accent colors, readable typography, responsive layout).\n- The <body> must contain: a header titled \"Daily Briefing\" with today's date, a summary card with key stats (emails processed, urgent items, first meeting, busiest block), an \"Emails\" section grouping the analyst's emails by category, and an \"Agenda\" section with the day timeline.\n- Use the analysts' content faithfully and never invent new emails or meetings.\n- Escape HTML-special characters inside any data values.\nOutput ONLY the raw HTML document, with no markdown fences and no explanations."
        }
      }
    },
    {
      "id": "0cff796a-4b5f-4ce2-90a8-26200a3bf7be",
      "name": "Director Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1440,
        640
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        }
      }
    },
    {
      "id": "eacc9cb5-4741-4122-9fd2-f21fa331284d",
      "name": "Format Dashboard HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const raw = String($json.output || '').trim();\nconst isHtml = /<!doctype\\s+html/i.test(raw) || /<html[\\s>]/i.test(raw);\nlet html = raw;\nif (!isHtml) {\n  const body = raw.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n  html = '<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>Daily Briefing</title><style>body{margin:0;padding:40px;background:#0f172a;color:#e2e8f0;font-family:Segoe UI,Arial,sans-serif}h1{color:#38bdf8;font-weight:600}pre{white-space:pre-wrap;font-family:inherit;font-size:15px;line-height:1.6;background:#1e293b;padding:24px;border-radius:12px}</style></head><body><h1>Daily Briefing</h1><pre>' + body + '</pre></body></html>';\n}\nreturn [{ json: { html: html, generatedAt: new Date().toISOString(), source: 'briefing-director-agent' } }];"
      }
    },
    {
      "id": "05878f38-be95-4fb4-85f3-38e4f3a6242a",
      "name": "Convert Dashboard To File",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
