    {
      "id": "9ca989ea-16b9-42ee-9cc1-4b11f06d5257",
      "name": "Get Recent Emails",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        240,
        180
      ],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "simple": true,
        "returnAll": false,
        "limit": 25,
        "filters": {
          "readStatus": "both",
          "receivedAfter": "={{ $now.minus({ days: 1 }).toISO() }}"
        }
      },
      "webhookId": "084cecf0-5a37-4147-8fdd-f6206f66d7f4"
    },
    {
      "id": "7de3b0dd-4e2b-47c6-abd0-5bd12410f875",
      "name": "Normalize Emails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst emails = items.map(function (i) {\n  const j = i.json || {};\n  const h = j.headers || {};\n  return {\n    from: j.From || h.From || 'unknown sender',\n    subject: j.Subject || h.Subject || '(no subject)',\n    date: j.Date || h.Date || j.internalDate || '',\n    snippet: String(j.snippet || '').slice(0, 300),\n    labels: j.labelIds || []\n  };\n});\nreturn [{ json: { emailCount: emails.length, emails: emails } }];"
      }
    },
    {
      "id": "815696d4-373e-4d38-9ab9-dfab37a7ed54",
      "name": "Email Analyst Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        720,
        180
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json.emails) }}",
        "options": {
          "systemMessage": "You are the Email Analyst Agent in a multi-agent daily briefing team.\nYou receive a JSON array of Gmail messages fetched in the last 24 hours (fields: from, subject, date, snippet, labels).\nSort and classify every email into exactly one category: Urgent (act today), Needs Reply, Meetings & Invites, FYI, or Noise & Newsletters.\nFor each email give: category, sender, subject, a one-line gist, and a priority (high / medium / low).\nFinish with a \"Top 3 Actions\" list. If the list is empty, say so explicitly.\nReply in concise plain text using short section headers and bullet lines.\nDo not invent emails that are not present in the data."
        }
      }
    },
    {
      "id": "32480ad5-fdb6-484b-9d9d-24a0444d4b70",
      "name": "Email Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        720,
        420
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        }
      }
    },
    {
      "id": "0df477e3-c266-43d9-8785-dc4d085a956f",
      "name": "Prepare Email Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return [{ json: { emailAnalysis: $json.output } }];"
      }
    },
    {
      "id": "a3fb28cf-ce75-482e-811f-cbf2e99639c2",
      "name": "Get Todays Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        240,
        620
      ],
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "id"
        },
        "timeMin": "={{ $now.startOf(\"day\").toISO() }}",
        "timeMax": "={{ $now.endOf(\"day\").toISO() }}",
        "returnAll": false,
        "limit": 50,
        "options": {
          "orderBy": "startTime",
          "recurringEventHandling": "expand"
        }
      }
    },
    {
      "id": "ba1f1592-1385-4d93-8971-6a75bb27aec2",
      "name": "Normalize Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        620
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst events = items.map(function (i) {\n  const j = i.json || {};\n  const start = (j.start && (j.start.dateTime || j.start.date)) || '';\n  const end = (j.end && (j.end.dateTime || j.end.date)) || '';\n  return {\n    summary: j.summary || '(no title)',\n    start: start,\n    end: end,\n    location: j.location || '',\n    attendees: Array.isArray(j.attendees) ? j.attendees.length : 0,\n    meetLink: j.hangoutLink || '',\n    description: String(j.description || '').slice(0, 300)\n  };\n});\nevents.sort(function (a, b) { return String(a.start).localeCompare(String(b.start)); });\nreturn [{ json: { eventCount: events.length, events: events } }];"
      }
    },
    {
      "id": "032abea8-2de3-4d42-80c7-0e4d46227d99",
      "name": "Calendar Analyst Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        720,
        620
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json.events) }}",
        "options": {
          "systemMessage": "You are the Calendar Analyst Agent in a multi-agent daily briefing team.\nYou receive a JSON array of today's Google Calendar events (fields: summary, start, end, location, attendees, meetLink, description), already sorted by start time.\nProduce a chronological run of day: for each event give start-end time, title, location or meeting link, and attendee count.\nHighlight the first event of the day, back-to-back or overlapping blocks, and remaining free windows.\nIf there are no events, say so explicitly.\nReply in concise plain text using short section headers and bullet lines.\nDo not invent events that are not present in the data."
        }
      }
    },
    {
      "id": "1bc1ee9b-cbab-4546-8b75-84d56634f6e8",
      "name": "Calendar Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        720,
        860
      ],
      "parameters": {
