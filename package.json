{
  "name": "n8n-harness-benchmark",
  "version": "1.0.0",
  "description": "Standardized benchmark harness comparing n8n-as-code with n8n Native MCP for AI-driven workflow creation under identical, scientifically impartial conditions.",
  "type": "module",
  "main": "benchmark/cli.mjs",
  "bin": {
    "n8n-benchmark": "./benchmark/cli.mjs"
  },
  "scripts": {
    "verify": "node benchmark/cli.mjs verify",
    "evaluate": "node benchmark/cli.mjs evaluate",
    "validate": "node benchmark/harness/validator.mjs",
    "report": "node benchmark/harness/compiler.mjs",
    "guard": "node benchmark/harness/isolation-guard.mjs",
    "test": "node benchmark/harness/isolation-guard.mjs --self-check && node benchmark/harness/predicates.mjs --self-check && node benchmark/harness/toolchain-check.mjs --self-check && npm run check:site",
    "facts": "node benchmark/harness/predicates.mjs",
    "ready": "node benchmark/harness/toolchain-check.mjs --ready",
    "used": "node benchmark/harness/toolchain-check.mjs --used",
    "check:site": "node scripts/check-site.mjs"
  },
  "keywords": [
    "n8n",
    "n8n-as-code",
    "mcp",
    "model-context-protocol",
    "benchmark",
    "agentic-coding",
    "llm",
    "gemini"
  ],
  "author": "Etienne Lescot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EtienneLescot/n8n-harness-benchmark.git"
  },
  "bugs": {
    "url": "https://github.com/EtienneLescot/n8n-harness-benchmark/issues"
  },
  "homepage": "https://github.com/EtienneLescot/n8n-harness-benchmark#readme",
  "dependencies": {
    "n8nac": "^2.7.0"
  }
}
