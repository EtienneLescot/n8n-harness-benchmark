# ----------------------------------------------------
# 1. Benchmark Execution Metadata (Required for Leaderboard & PRs)
# ----------------------------------------------------
BENCHMARK_HARNESS=Antigravity # e.g. Antigravity, Claude-Code, Cursor, Windsurf, Custom-Agent
BENCHMARK_PRIMARY_AGENT=Antigravity Orchestrator
BENCHMARK_MODEL=Gemini 3.8 Flash High # e.g. gemini-3.8-flash, claude-3-7-sonnet, gpt-4.5
BENCHMARK_TEMPERATURE=0.2
BENCHMARK_SUBAGENT_RUNTIME=invoke_subagent # e.g. invoke_subagent, process_fork, docker_sandbox

# ----------------------------------------------------
# 2. n8n Instance Connection
# ----------------------------------------------------
N8N_HOST=https://your-instance.app.n8n.cloud
N8N_API_KEY=your_n8n_api_key_here

# ----------------------------------------------------
# 3. n8n Native MCP Endpoint & Token (Instance-Level MCP)
# ----------------------------------------------------
N8N_NATIVE_MCP_URL=https://your-instance.app.n8n.cloud/mcp-server/http
N8N_NATIVE_MCP_TOKEN=your_native_mcp_bearer_token_here
N8NAC_NATIVE_MCP_ENABLED=1
N8NAC_NATIVE_MCP_MODE=assist

# ----------------------------------------------------
# 4. LLM API Credentials (Optional / for direct API evaluation)
# ----------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
