  "nodes": [
    {
      "id": "c40698be-9e30-4d3a-bc53-11b877382369",
      "name": "Daily Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        -460,
        260
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 7,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "38b81e11-b8bc-4eb9-aa09-0aa1d1769b0d",
      "name": "Get Today's Emails",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        -220,
        80
      ],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": true,
        "filters": {
          "readStatus": "both",
          "receivedAfter": "={{ $now.startOf('day') }}"
        }
      },
      "webhookId": "fdbc6dbf-d113-4bb0-88b4-cfbbf28d8387"
    },
    {
      "id": "c0b8c368-f690-4e52-b4af-7e43b7964f03",
      "name": "Collect Emails",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        20,
        80
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "emails"
      }
    },
    {
      "id": "cc35ccf4-6f10-4199-aee3-7c1a78f2ed17",
      "name": "Email Triage Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        260,
        80
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json.emails) }}",
        "options": {
          "systemMessage": "You are an email triage assistant. You receive today's Gmail messages as a JSON array under 'emails' (subject, from, snippet, date for each). Sort every email into one of: Urgent, Action Needed, FYI, Newsletter/Promotional. For each category, list sender and subject on one line. If the array is empty, say there are no new emails today. Respond in plain text only, no HTML, no markdown code fences."
        }
      }
    },
    {
      "id": "cd8953e8-674a-44ce-b20c-cf575a36f637",
      "name": "Get Today's Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        -220,
        400
      ],
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "id"
        },
        "timeMin": "={{ $now.startOf('day') }}",
        "timeMax": "={{ $now.endOf('day') }}",
        "returnAll": true,
        "options": {
          "singleEvents": true,
          "orderBy": "startTime"
        }
      }
    },
    {
      "id": "6a7370f8-a99b-4783-89f4-e66ea8d5bb6d",
      "name": "Collect Events",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        20,
        400
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "events"
      }
    },
    {
      "id": "e5f43bb8-212e-4381-9716-70bf604caf10",
      "name": "Calendar Analyst Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        260,
        400
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json.events) }}",
        "options": {
          "systemMessage": "You are a calendar analyst. You receive today's Google Calendar events as a JSON array under 'events' (summary, start, end, location, attendees for each). Summarize the day's schedule in chronological order, flag any back-to-back or overlapping meetings, and note free gaps longer than one hour. If the array is empty, say the day is free. Respond in plain text only, no HTML, no markdown code fences."
        }
      }
    },
    {
      "id": "656ba4fd-b4e4-44ff-af28-50058eff6814",
      "name": "Wait For Both Agents",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        500,
        240
      ],
      "parameters": {
        "mode": "append"
      }
    },
    {
      "id": "ee84353b-88c1-4344-b5cd-23c2164f0551",
      "name": "Dashboard Composer Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        740,
        240
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Email summary:\\n' + $('Email Triage Agent').first().json.output + '\\n\\nCalendar summary:\\n' + $('Calendar Analyst Agent').first().json.output + '\\n\\nToday: ' + $now.format('cccc, LLLL d, yyyy') }}",
        "options": {
          "systemMessage": "You are an HTML report generator. You receive an email summary and a calendar summary for today. Produce exactly one complete, self-contained HTML document (starting with <!DOCTYPE html>, including <html>, a <head> with an inline <style> block, and a <body>) styled as a clean daily briefing dashboard with two clearly labeled sections, 'Inbox' and 'Schedule'. Use only inline CSS, no external resources or scripts. Return ONLY the raw HTML with no markdown code fences and no commentary before or after it."
        }
      }
    },
    {
      "id": "a65903e5-0a28-4bdc-b060-c996f2b0fa63",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        500,
        620
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "id"
        }
      }
    }
  ],
