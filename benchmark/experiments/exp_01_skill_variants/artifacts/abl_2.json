    },
    {
      "id": "b4ef1eca-b7e3-4e4a-a774-58fd691ed129",
      "name": "Fetch Today's Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        260,
        460
      ],
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "list"
        },
        "timeMin": "={{ $now.startOf(\"day\").toISO() }}",
        "timeMax": "={{ $now.endOf(\"day\").toISO() }}",
        "returnAll": true
      }
    },
    {
      "id": "c2fa651c-f667-466f-8a77-cc92cdb26eb9",
      "name": "Summarize Emails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const emails = items.map(i => {\n  const headers = i.json.payload?.headers || [];\n  const header = (n) => headers.find(h => h.name?.toLowerCase() === n)?.value || '';\n  return {\n    subject: i.json.subject || header('subject') || '(no subject)',\n    from: i.json.from || header('from') || '',\n    snippet: i.json.snippet || '',\n    date: i.json.date || header('date') || '',\n  };\n});\nreturn [{ json: { emails } }];"
      }
    },
    {
      "id": "ea26b2b8-fffc-4d23-b1a1-e088781ab14c",
      "name": "Summarize Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        460
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const events = items.map(i => ({\n  summary: i.json.summary || '(no title)',\n  start: i.json.start?.dateTime || i.json.start?.date || '',\n  end: i.json.end?.dateTime || i.json.end?.date || '',\n  location: i.json.location || '',\n  attendees: (i.json.attendees || []).map(a => a.email).filter(Boolean).join(', '),\n}));\nreturn [{ json: { events } }];"
      }
    },
    {
      "id": "8e5988d4-7954-40f2-9f26-0d2bc21ccd02",
      "name": "Combine Inbox And Calendar",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        780,
        300
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "numberInputs": 2
      }
    },
    {
      "id": "aa3471ef-6d9d-4020-8338-f735cf192af1",
      "name": "Briefing Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1040,
        620
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-5-mini",
          "mode": "list"
        }
      }
    },
    {
      "id": "2f2ed7bb-0e19-43fa-a509-4c24d686ec0a",
      "name": "Sort And Prioritize Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1040,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Today's emails (JSON): {{ JSON.stringify($json.emails) }}\n\nToday's calendar events (JSON): {{ JSON.stringify($json.events) }}\n\nSort and prioritize this information. Respond with ONLY valid JSON (no markdown fences) shaped like:\n{\"urgentEmails\": [{\"subject\": \"\", \"from\": \"\", \"why\": \"\"}], \"meetings\": [{\"summary\": \"\", \"start\": \"\", \"end\": \"\", \"location\": \"\"}], \"actionItems\": [\"short todo strings extracted from emails\"], \"fyi\": [\"short low-priority notes\"]}\nOrder meetings chronologically by start time.",
        "options": {
          "systemMessage": "You are a meticulous personal assistant that triages email and calendar data into structured JSON for a daily dashboard. Always respond with strict JSON only, no prose, no markdown fences."
        }
      }
    },
    {
      "id": "59d7fa0d-f98e-4e7b-a5cb-547424ae9dc7",
      "name": "Dashboard Builder Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Build a complete, self-contained HTML daily briefing dashboard from this prioritized data (JSON): {{ $json.output }}\n\nRequirements: a single HTML document with an inline <style> block, no external assets or scripts, a header showing today's date, sections for Urgent Emails, Today's Meetings (chronological), Action Items, and FYI, clean readable typography, and a responsive card-based layout. Respond with ONLY the raw HTML document, starting with <!DOCTYPE html>, no markdown fences.",
        "options": {
          "systemMessage": "You are a frontend assistant that outputs a single polished, self-contained HTML dashboard document and nothing else."
        }
      }
    },
    {
      "id": "d59079c9-7209-4aa1-91dd-4d6a62ec6db3",
      "name": "Daily Briefing Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return [{ json: { html: items[0].json.output, generatedAt: new Date().toISOString() } }];"
      }
    }
  ],
