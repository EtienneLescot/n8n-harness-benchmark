    {
      "id": "6a0dabe7-db28-43a3-9627-0356c7469c24",
      "name": "Fetch Emails (Last 24h)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        540,
        160
      ],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": true,
        "simple": true,
        "filters": {
          "q": "newer_than:1d",
          "readStatus": "both",
          "includeSpamTrash": false
        }
      },
      "webhookId": "ba553359-700d-4f8a-939e-206735355277"
    },
    {
      "id": "42570a34-b5f5-4ec3-9294-2dee561d87d7",
      "name": "Email Triage Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        840,
        160
      ],
      "parameters": {
        "promptType": "define",
        "text": "=You are an email triage assistant. Review the emails below from the last 24 hours and produce a short categorized brief with sections Urgent, Action Needed, FYI, and Newsletters or Promotions. Under each section list sender, subject and a one-line takeaway. If a section has no emails, omit it.\n\nEmails JSON:\n{{ JSON.stringify($input.all().map(item => item.json)) }}",
        "options": {
          "systemMessage": "You are a precise, concise email triage assistant for a daily briefing. Never invent emails that are not in the provided data."
        }
      },
      "executeOnce": true
    },
    {
      "id": "7bed260d-10d9-4b9c-87b9-08d017f9e133",
      "name": "Email Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        700,
        40
      ],
      "parameters": {},
      "credentials": {
        "openAiApi": {
          "id": "3tpHjeLbkX5PIuNM",
          "name": "n8n free OpenAI API credits"
        }
      }
    },
    {
      "id": "cdb7dcc6-4284-487c-9278-47551fee5de9",
      "name": "Label Email Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1040,
        160
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "email-brief",
              "name": "emailBrief",
              "value": "={{ $json.output }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "0238f555-241d-415c-8d79-299030b2519e",
      "name": "Combine Summaries",
      "type": "n8n-nodes-base.merge",
