    {
      "id": "e065ef66-ca89-49ae-9e04-65ad7728b3e2",
      "name": "Email Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        220,
        140
      ],
      "parameters": {
        "promptType": "define",
        "text": "=You are an email triage assistant. Sort and summarize today's Gmail inbox activity into categories: Action Needed, FYI, Newsletters/Promotions, Personal. For each item, list the sender, subject and a one-line summary. Call out anything urgent or time-sensitive at the top. Only use the data provided, never invent emails.\n\nEmails (JSON):\n{{ JSON.stringify($json.emails) }}",
        "options": {
          "systemMessage": "You are a precise email triage assistant. Output clear, well-structured markdown. Never invent emails that are not present in the provided data."
        }
      }
    },
    {
      "id": "9b91a0db-5608-4aa4-afff-fa932e0b1655",
      "name": "Calendar Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        220,
        460
      ],
      "parameters": {
        "promptType": "define",
        "text": "=You are a calendar assistant. Summarize today's Google Calendar schedule in chronological order: time, event title, and location/attendees when present. Flag any back-to-back meetings or conflicts. Only use the data provided, never invent events.\n\nEvents (JSON):\n{{ JSON.stringify($json.events) }}",
        "options": {
          "systemMessage": "You are a precise calendar assistant. Output clear, well-structured markdown. Never invent events that are not present in the provided data."
        }
      }
    },
    {
      "id": "a247558a-05af-4aa9-96d9-55f429621fdd",
      "name": "Merge Summaries",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "mode": "append",
        "numberInputs": 2
      }
    },
    {
      "id": "5dd59f27-5769-455d-8021-a8a026df0307",
      "name": "Combine Summaries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nreturn [{ json: { emailSummary: items[0]?.json?.output ?? '', calendarSummary: items[1]?.json?.output ?? '' } }];"
      }
    },
    {
      "id": "0c2e76e9-1eae-4be0-9377-320688b2a828",
      "name": "Dashboard Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        880,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Compose a single self-contained HTML daily briefing dashboard from the two summaries below. Use inline CSS only (no external assets or scripts), a clean card-based layout, a header with today's date, and two sections titled \"Email Summary\" and \"Calendar Summary\" that render the markdown content as readable HTML. Output ONLY the raw HTML document, starting with <!DOCTYPE html> and nothing else.\n\nEmail Summary:\n{{ $json.emailSummary }}\n\nCalendar Summary:\n{{ $json.calendarSummary }}",
        "options": {
          "systemMessage": "You are a meticulous front-end assistant that outputs a single, valid, self-contained HTML document and nothing else. No markdown fences, no commentary."
        }
      }
    },
    {
      "id": "c2d8e338-4aad-4ce8-bcd4-14509c0f16b1",
      "name": "Send Dashboard Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "etienne@etiennelescot.fr",
        "subject": "=Daily Briefing - {{ $now.format(\"yyyy-MM-dd\") }}",
        "emailType": "html",
        "message": "={{ $json.output }}"
      },
      "webhookId": "32784440-6d7d-4bac-aa12-035f17fc8999"
    }
  ],
