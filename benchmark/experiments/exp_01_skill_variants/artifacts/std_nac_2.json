        "returnAll": true
      }
    },
    {
      "id": "528b17c9-0dfc-4e36-8783-481628c7c14d",
      "name": "Prepare Email Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const emails = $input.all().map(i => i.json);\nreturn [{ json: { emailsJson: JSON.stringify(emails), count: emails.length } }];"
      }
    },
    {
      "id": "aec18f9b-07eb-4f40-8509-776c25ab1454",
      "name": "Prepare Calendar Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        460
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const events = $input.all().map(i => i.json);\nreturn [{ json: { eventsJson: JSON.stringify(events), count: events.length } }];"
      }
    },
    {
      "id": "cd82abf0-8bf0-4646-8e99-d250c2413895",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        780,
        760
      ],
      "parameters": {
        "model": {
