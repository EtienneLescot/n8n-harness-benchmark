  "nodes": [
    {
      "id": "07ad0af1-9442-4ec0-ad0d-d8cc32454941",
      "name": "Daily 7am Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        208
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 7,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "b7695337-a964-476e-a3cd-3ac4e3c85554",
      "name": "Fetch Todays Emails",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        224,
        112
      ],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 50,
        "simple": true,
        "filters": {
          "q": "newer_than:1d"
        }
      },
      "webhookId": "74745cdb-e4a3-4ab5-b108-2cc6664f467a"
    },
    {
      "id": "88e76ec3-bbe0-47cc-80f3-684d52b3848c",
      "name": "Sort And Tag Emails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        112
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst emails = items.map((item) => ({\n  id: item.json.id,\n  subject: item.json.Subject,\n  from: item.json.From,\n  snippet: item.json.snippet,\n  receivedAt: item.json.internalDate,\n  unread: (item.json.labels || []).some((l) => l.name === \"UNREAD\")\n}));\nreturn [{ json: { emailCount: emails.length, emails: emails } }];"
      }
    },
    {
      "id": "f8fc8c4a-ad86-4d35-bfe1-eebfb02de239",
      "name": "Combine Emails And Events",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        672,
        208
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition"
      }
    },
    {
      "id": "9a6a4502-ba74-49ec-9ee7-48607657d819",
      "name": "Fetch Todays Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        224,
        304
      ],
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "primary"
        },
        "returnAll": true,
        "timeMin": "={{ $today.toISO() }}",
        "timeMax": "={{ $today.plus({ days: 1 }).toISO() }}",
        "options": {
          "singleEvents": true,
          "orderBy": "startTime"
        }
      }
    },
    {
      "id": "2e464806-8447-42e1-80d6-3f971c7f79f3",
      "name": "Sort And Tag Calendar Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        304
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst events = items.map((item) => ({\n  id: item.json.id,\n  title: item.json.summary,\n  start: item.json.start && item.json.start.dateTime,\n  end: item.json.end && item.json.end.dateTime,\n  status: item.json.status\n}));\nevents.sort((a, b) => String(a.start || \"\").localeCompare(String(b.start || \"\")));\nreturn [{ json: { eventCount: events.length, events: events } }];"
      }
    },
    {
      "id": "26ec35c4-b796-4c49-a0a4-c1c182024b71",
      "name": "Daily Briefing Orchestrator",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        960,
        208
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Today is {{ $now.toFormat(\"cccc, LLLL d yyyy\") }}. There are {{ $json.emailCount }} new emails and {{ $json.eventCount }} calendar events today. Call the \"Email Triage Agent\" tool and the \"Calendar Digest Agent\" tool, then combine both results into one complete HTML daily briefing dashboard page.",
        "hasOutputParser": false,
        "options": {
          "systemMessage": "You are the orchestrator for a daily briefing dashboard. You have two tools: \"Email Triage Agent\" (returns prioritized, categorized emails as HTML list items) and \"Calendar Digest Agent\" (returns a chronological agenda as HTML list items). Always call BOTH tools first, then respond with ONLY a single complete, self-contained HTML document (starting with <!DOCTYPE html>) that renders as a polished daily briefing dashboard: a header with today date, an Agenda section using the Calendar Digest Agent output, and an Inbox section using the Email Triage Agent output. Use an inline <style> block only, no external resources, no markdown, no commentary outside the HTML."
        }
      }
    },
    {
      "id": "93f1a07b-ef30-43f0-b5bc-c0cbeb9777e6",
      "name": "Claude - Orchestrator Model",
