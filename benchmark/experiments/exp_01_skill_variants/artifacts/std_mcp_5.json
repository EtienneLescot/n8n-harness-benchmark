        "anthropicApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "id": "25cf6f56-3ce5-4a51-907d-598dd11d73c2",
      "name": "Email Triage Agent",
      "type": "@n8n/n8n-nodes-langchain.agentTool",
      "typeVersion": 3,
      "position": [
        1024,
        432
      ],
      "parameters": {
        "toolDescription": "Analyzes and prioritizes todays emails. Call this once to get a sorted, categorized summary of the inbox as HTML list items.",
        "text": "=You are an email triage specialist for a daily briefing. Read the emails JSON below, then respond with ONLY a prioritized (Urgent, Normal, Low) and categorized (Finance, Work, Personal, Newsletter, Other) summary as HTML <li> elements grouped under <h4> headings. No outer html/body tags, no commentary.\n\nEmails JSON:\n{{ JSON.stringify($(\"Combine Emails And Events\").item.json.emails) }}"
      }
    },
