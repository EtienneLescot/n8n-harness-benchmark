{
  "description": null,
  "active": false,
  "activeVersionId": null,
  "isArchived": false,
  "sourceWorkflowId": null,
  "nodes": [
    {
      "name": "Daily 7am Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        200,
        400
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 7,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "name": "Fetch Today's Emails",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        460,
        220
      ],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 50,
        "simple": true,
        "filters": {
          "q": "newer_than:1d",
          "readStatus": "both"
        }
      }
    },
    {
      "name": "Aggregate Emails",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        680,
        220
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "emails"
      }
    },
    {
      "name": "Email Sorting Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        900,
        220
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Today's Gmail inbox as JSON:\n{{ JSON.stringify($json.emails) }}\n\nSort and group these emails into priority buckets.",
        "options": {
          "systemMessage": "You are the Email Sorting Agent in a daily briefing pipeline. You receive JSON describing the JSON.stringify emails from Gmail. Group them into four buckets in this order: Urgent, Action Needed, FYI, Low Priority. For every email give the sender, subject and a one-line gist. Return a concise plain-text summary organized by bucket, most urgent bucket first. Never invent emails that are not present in the input. If the input list is empty, say the inbox is clear."
        }
      }
    },
    {
      "name": "Anthropic Model (Email Agent)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        880,
        100
      ],
      "parameters": {}
    },
    {
      "name": "Combine Agent Outputs",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1160,
        400
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition"
      }
    },
    {
      "name": "Fetch Today's Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        460,
        580
      ],
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "primary"
        },
        "returnAll": true,
        "timeMin": "={{ $today }}",
        "timeMax": "={{ $today.plus({ days: 1 }) }}",
        "options": {
          "singleEvents": true,
          "orderBy": "startTime"
        }
      }
    },
    {
      "name": "Aggregate Events",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        680,
        580
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "events"
      }
    },
    {
      "name": "Calendar Summarizer Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        900,
        580
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Today's Google Calendar events as JSON:\n{{ JSON.stringify($json.events) }}\n\nBuild today's agenda.",
        "options": {
          "systemMessage": "You are the Calendar Summarizer Agent in a daily briefing pipeline. You receive JSON describing today's Google Calendar events. Produce a concise chronological plain-text agenda: time range, title, and location or attendees when present. Flag any back-to-back meetings with no gap between them. If the event list is empty, say the day is clear."
        }
      }
    },
    {
      "name": "Anthropic Model (Calendar Agent)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        880,
        460
      ],
      "parameters": {}
    },
    {
      "name": "Briefing Composer Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1400,
        400
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Prioritized email summary:\n{{ $('Email Sorting Agent').item.json.output }}\n\nToday's calendar agenda:\n{{ $('Calendar Summarizer Agent').item.json.output }}\n\nCompose the complete HTML daily briefing dashboard now.",
        "options": {
          "systemMessage": "You are the Briefing Composer Agent, the final step of a daily briefing pipeline. You receive a prioritized email summary and a calendar agenda, each already produced by an upstream specialist agent. Combine them into one complete, self-contained HTML document: a styled daily briefing dashboard with a header showing today's date, a Schedule section built from the agenda, and an Inbox section broken down by priority bucket. Use inline CSS only, no external stylesheets and no script tags, so it renders correctly in email clients. Output ONLY the raw HTML document, starting with <!DOCTYPE html>, nothing else before or after it."
        }
      }
    },
    {
      "name": "Anthropic Model (Briefing Agent)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        1160,
        260
      ],
      "parameters": {}
    },
    {
      "name": "Send Daily Briefing Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1640,
        400
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "etienne@etiennelescot.fr",
        "subject": "=Daily Briefing - {{ $now.toFormat(\"cccc, LLLL d\") }}",
        "emailType": "html",
        "message": "={{ $json.output }}"
      }
    }
  ],
