  "isArchived": false,
  "sourceWorkflowId": null,
  "nodes": [
    {
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 7,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "name": "Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        260,
        140
      ],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 50,
        "simple": true,
        "filters": {
          "q": "newer_than:1d"
        }
      }
    },
    {
      "name": "Google Calendar",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        260,
        460
      ],
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "list"
        },
        "timeMin": "={{ $today.toISO() }}",
        "timeMax": "={{ $today.plus({ days: 1 }).toISO() }}",
        "returnAll": true
      }
    },
    {
      "name": "Prepare Email Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const emails = $input.all().map(i => i.json);\nreturn [{ json: { emailsJson: JSON.stringify(emails), count: emails.length } }];"
      }
    },
    {
      "name": "Prepare Calendar Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        460
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const events = $input.all().map(i => i.json);\nreturn [{ json: { eventsJson: JSON.stringify(events), count: events.length } }];"
      }
    },
    {
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        780,
        760
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        }
      }
    },
    {
      "name": "Email Triage Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        780,
        140
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.emailsJson }}",
        "options": {
          "systemMessage": "You are an email triage assistant. You receive a JSON array of raw Gmail message objects covering the last 24 hours. Categorize each message into one of: Urgent, Action Needed, FYI, Newsletter/Promotions. Output a clean HTML fragment only (no markdown, no code fences): one <h3> heading per non-empty category, followed by a <ul> with one <li> per email showing the sender, subject, and a one-line summary. If there are no emails, output '<p>No new emails.</p>'."
        }
      }
    },
    {
      "name": "Calendar Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        780,
        460
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.eventsJson }}",
        "options": {
          "systemMessage": "You are a calendar assistant. You receive a JSON array of raw Google Calendar event objects for today. Summarize the day: list each event with its time range and title, and flag any overlapping or back-to-back meetings as conflicts. Output a clean HTML fragment only (no markdown, no code fences): a <ul> of events (<li> with time range and title), followed by a <p> noting conflicts or 'No conflicts.' if there are none. If there are no events, output '<p>No events scheduled today.</p>'."
        }
      }
    },
    {
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1040,
        300
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "numberInputs": 2
      }
    },
    {
      "name": "Dashboard Composer Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ 'EMAIL SUMMARY:\\n' + $('Email Triage Agent').first().json.output + '\\n\\nCALENDAR SUMMARY:\\n' + $('Calendar Agent').first().json.output }}",
        "options": {
          "systemMessage": "You are a daily briefing dashboard builder. You receive an HTML email summary and an HTML calendar summary. Combine them into one complete, self-contained HTML document: start with <!DOCTYPE html>, include an inline <style> block for a clean modern dashboard look (cards, readable fonts, light background), a header showing today's date, an 'Inbox' section containing the email summary, and a 'Today's Schedule' section containing the calendar summary. Return only the final HTML document, no markdown fences, no commentary."
        }
      }
    },
    {
      "name": "Send Briefing Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1560,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "etienne@etiennelescot.fr",
        "subject": "={{ 'Daily Briefing - ' + $today.toFormat('yyyy-LL-dd') }}",
        "emailType": "html",
        "message": "={{ $json.output }}"
      }
    }
  ],
