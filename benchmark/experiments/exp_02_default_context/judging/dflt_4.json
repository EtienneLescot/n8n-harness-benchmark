  "isArchived": false,
  "sourceWorkflowId": null,
  "nodes": [
    {
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 7,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "name": "Fetch Todays Emails",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 50,
        "filters": {
          "q": "newer_than:1d",
          "readStatus": "both"
        }
      }
    },
    {
      "name": "Fetch Todays Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        280,
        600
      ],
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "list",
          "cachedResultName": "primary"
        },
        "returnAll": true,
        "timeMin": "={{ $today.startOf(\"day\") }}",
        "timeMax": "={{ $today.endOf(\"day\") }}",
        "options": {
          "singleEvents": true,
          "orderBy": "startTime"
        }
      }
    },
    {
      "name": "Combine Emails",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        560,
        0
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "emails"
      }
    },
    {
      "name": "Combine Events",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        560,
        600
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "events"
      }
    },
    {
      "name": "Briefing Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        850,
        900
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-5-mini",
          "mode": "list"
        }
      }
    },
    {
      "name": "Email Triage Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        850,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Today's emails as JSON:\n{{ JSON.stringify($json.emails) }}",
        "options": {
          "systemMessage": "You are an email triage assistant. Read the list of today's emails (JSON array with sender, subject, snippet, date). Sort them into Urgent, Needs Reply, and FYI groups, dropping obvious newsletters/promotions into FYI. Respond with a concise plain-text summary organized under those three headings, one line per email (sender - subject)."
        }
      }
    },
    {
      "name": "Calendar Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        850,
        600
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Today's calendar events as JSON:\n{{ JSON.stringify($json.events) }}",
        "options": {
          "systemMessage": "You are a calendar assistant. Read the list of today's events (JSON array with summary, start, end, location, attendees). Sort them chronologically and flag any back-to-back or overlapping meetings. Respond with a concise plain-text agenda, one line per event (time - title - location)."
        }
      }
    },
    {
      "name": "Combine Agent Outputs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1130,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const emailSummary = $('Email Triage Agent').first().json.output;\nconst calendarSummary = $('Calendar Agent').first().json.output;\nreturn [{ json: { emailSummary, calendarSummary } }];"
      }
    },
    {
      "name": "Briefing Composer Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1400,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Email triage summary:\n{{ $json.emailSummary }}\n\nCalendar agenda:\n{{ $json.calendarSummary }}",
        "options": {
          "systemMessage": "You are a daily-briefing designer. Given an email triage summary and a calendar agenda, produce a single self-contained HTML page (inline <style>, no external assets) that presents an \"Daily Briefing Dashboard\": a header with today's date, an Agenda section rendering the calendar agenda as a timeline, and an Inbox section rendering the email triage groups as cards. Respond with ONLY the raw HTML document, no markdown code fences, no commentary."
        }
      }
    },
    {
      "name": "Send Briefing Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1680,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "YOUR_EMAIL@example.com",
        "subject": "=Daily Briefing Dashboard - {{ $today.toFormat(\"yyyy-LL-dd\") }}",
        "emailType": "html",
        "message": "={{ $json.output }}",
        "options": {}
      }
    }
  ],
