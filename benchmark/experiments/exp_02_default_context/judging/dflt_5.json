  "isArchived": false,
  "sourceWorkflowId": null,
  "nodes": [
    {
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        200,
        380
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 7,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "name": "Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        460,
        140
      ],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 50,
        "simple": true,
        "filters": {
          "receivedAfter": "={{ $now.startOf('day').toISO() }}"
        }
      }
    },
    {
      "name": "Aggregate Emails",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        700,
        140
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "emails"
      }
    },
    {
      "name": "Google Calendar",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        460,
        560
      ],
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "id"
        },
        "timeMin": "={{ $now.startOf('day').toISO() }}",
        "timeMax": "={{ $now.endOf('day').toISO() }}",
        "returnAll": true,
        "options": {
          "singleEvents": true,
          "orderBy": "startTime"
        }
      }
    },
    {
      "name": "Aggregate Events",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        700,
        560
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "events"
      }
    },
    {
      "name": "OpenAI Chat Model (Email)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        900,
        -20
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-5-mini",
          "mode": "list"
        }
      }
    },
    {
      "name": "Email Triage Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        960,
        140
      ],
      "parameters": {
        "promptType": "define",
        "text": "=You are an email triage assistant. Analyze the emails received today (JSON below) and sort them into priority groups: Urgent, Action Needed, FYI, Newsletters/Promotions. For each email, list the sender, subject, and a one-line takeaway. Be concise and use plain text.\n\nEmails (JSON):\n{{ JSON.stringify($json.emails) }}",
        "options": {
          "systemMessage": "You are a precise, concise email triage assistant. Always respond in plain text, no markdown."
        }
      }
    },
    {
      "name": "OpenAI Chat Model (Calendar)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        900,
        400
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-5-mini",
          "mode": "list"
        }
      }
    },
    {
      "name": "Calendar Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        960,
        560
      ],
      "parameters": {
        "promptType": "define",
        "text": "=You are a calendar assistant. Analyze today's events (JSON below) and produce a clear, time-ordered summary: meeting times, titles, locations or links, and any back-to-back conflicts. Be concise and use plain text.\n\nEvents (JSON):\n{{ JSON.stringify($json.events) }}",
        "options": {
          "systemMessage": "You are a precise, concise calendar assistant. Always respond in plain text, no markdown."
        }
      }
    },
    {
      "name": "Prepare Email Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1220,
        140
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "emailSummary",
              "value": "={{ $json.output }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Prepare Calendar Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1220,
        560
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "calendarSummary",
              "value": "={{ $json.output }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Merge Summaries",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1480,
        350
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "numberInputs": 2
      }
    },
    {
      "name": "OpenAI Chat Model (Composer)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1620,
        190
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-5-mini",
          "mode": "list"
        }
      }
    },
    {
      "name": "Briefing Composer Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1740,
        350
      ],
      "parameters": {
        "promptType": "define",
        "text": "=You are a dashboard designer. Using the email summary and calendar summary below, produce a single, complete, self-contained HTML document (including <html>, <head> with inline <style> CSS, and <body>) that presents a visually clean 'Daily Briefing Dashboard' for today. Include a header with today's date, a schedule section built from the calendar summary, and an email section grouped by priority from the email summary. Output ONLY the raw HTML, no markdown code fences, no commentary.\n\nEmail Summary:\n{{ $json.emailSummary }}\n\nCalendar Summary:\n{{ $json.calendarSummary }}",
        "options": {
          "systemMessage": "You are an HTML dashboard generator. Always output a single complete, valid, self-contained HTML document and nothing else."
        }
      }
    },
    {
      "name": "Daily Briefing Dashboard",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        2000,
        350
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "html",
              "value": "={{ $json.output }}",
              "type": "string"
            },
            {
              "id": "2",
              "name": "generatedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        }
      }
    }
