  "nodes": [
    {
      "id": "1ca64044-3cc8-460e-981a-0f29f21489a5",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        250,
        450
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 7,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "1f4c9c69-1685-4cdb-9604-a65a932e0a55",
      "name": "Get Todays Emails",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 50,
        "filters": {
          "receivedAfter": "={{ $today }}"
        }
      },
      "webhookId": "c9de52d6-2672-40d3-8064-49e3d9d23dcb"
    },
    {
      "id": "66db9e90-fa6f-4fd2-8edc-2b307efc66aa",
      "name": "Get Todays Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        500,
        600
      ],
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "list",
          "cachedResultName": "primary"
        },
        "returnAll": false,
        "limit": 50,
        "timeMin": "={{ $today }}",
        "timeMax": "={{ $today.plus({ days: 1 }) }}"
      }
    },
    {
      "id": "ed5b5a76-3241-47d4-b7f6-a4f99b1d9030",
      "name": "Aggregate Emails",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        750,
        300
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "emails"
      }
    },
    {
      "id": "7d223148-9d13-4e6e-a2d2-06238c33a71e",
      "name": "Aggregate Events",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        750,
        600
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "events"
      }
    },
    {
      "id": "7d716674-35c4-4a37-884d-31ec6ee055c3",
      "name": "Email Sorting Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Today's raw Gmail messages as JSON:\n\n{{ JSON.stringify($json.emails) }}\n\nSort and summarize them.",
        "options": {
          "systemMessage": "You are an email triage assistant. Given a JSON array of raw Gmail messages, group them into priority categories (Urgent, Important, Newsletter/Other), and for each email give the sender, subject, and a one-line summary. Flag anything that needs a reply today. Respond in concise plain text or lightweight markdown, no HTML."
        }
      }
    },
    {
      "id": "704825ed-4dc5-4165-9f5f-56903ed555ec",
      "name": "Calendar Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1000,
        600
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Today's raw Google Calendar events as JSON:\n\n{{ JSON.stringify($json.events) }}\n\nSummarize the day's schedule.",
        "options": {
          "systemMessage": "You are a calendar assistant. Given a JSON array of raw Google Calendar events, produce a clear chronological rundown of the day with times and titles, flag any back-to-back meetings or conflicts, and note free time blocks. Respond in concise plain text or lightweight markdown, no HTML."
        }
      }
    },
    {
      "id": "d27ba097-0f57-4403-a099-6bbcd97ce5c6",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1000,
        850
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        }
      }
    },
    {
      "id": "081845d4-39d8-49ce-8f4d-af05bc25c338",
      "name": "Rename Email Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "email-briefing",
              "name": "emailBriefing",
              "value": "={{ $json.output }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "da7b0a93-7f9a-4212-a85d-cc8195c53d74",
      "name": "Rename Calendar Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1250,
        600
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "calendar-briefing",
              "name": "calendarBriefing",
              "value": "={{ $json.output }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "ce425101-832b-43df-9e16-cbbb5e5c5ff3",
      "name": "Merge Briefings",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1500,
        450
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition"
      }
    },
    {
      "id": "91691aef-877d-4f82-8c77-cd219dc580b9",
      "name": "Compose HTML Dashboard",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1750,
        450
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Email summary:\n{{ $json.emailBriefing }}\n\nCalendar summary:\n{{ $json.calendarBriefing }}\n\nCombine these into today's daily briefing.",
        "options": {
          "systemMessage": "You are a daily briefing designer. Combine the email summary and the calendar summary you receive into a single, complete, self-contained HTML page (a full <html> document with inline CSS, no external assets or images) styled as a clean dashboard with two clearly labeled sections: Inbox and Schedule. Output ONLY the raw HTML and nothing else, no markdown code fences."
        }
      }
    },
    {
      "id": "b3aee639-1203-4b28-a631-27400e9c9d73",
      "name": "Send Daily Briefing",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        2000,
        450
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "etienne@etiennelescot.fr",
        "subject": "=Daily Briefing - {{ $today.toFormat('cccc, LLL d yyyy') }}",
        "emailType": "html",
        "message": "={{ $json.output }}"
      },
      "webhookId": "bb01e5e7-a33e-40b1-b68b-a9a9517c18af"
    }
