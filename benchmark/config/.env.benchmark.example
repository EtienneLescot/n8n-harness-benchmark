# n8n Instance Connection
N8N_HOST=http://localhost:5678
N8N_API_KEY=your_n8n_api_key_here

# n8n Native MCP Endpoint & Token (Instance-Level MCP)
# When Instance-level MCP is enabled in n8n (Settings > Instance-level MCP)
N8N_NATIVE_MCP_URL=http://localhost:5678/mcp-server/http
N8N_NATIVE_MCP_TOKEN=your_native_mcp_bearer_token_here
N8NAC_NATIVE_MCP_ENABLED=1
N8NAC_NATIVE_MCP_MODE=assist

# LLM Harness API Credentials (Gemini 3.8 Flash High)
GEMINI_API_KEY=your_google_gemini_api_key_here
# Optional fallback keys
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# Benchmark Mode & Settings
BENCHMARK_MODE=auto # "interactive" or "auto"
BENCHMARK_TIMEOUT_MS=900000
BENCHMARK_OUTPUT_DIR=./benchmark/reports
BENCHMARK_SANDBOX_DIR=./benchmark/sandboxes
